version(2);
project_name = "drift";

patterns = {
	"*.odin",
	"*.sh",
	"*.4coder",
};

blacklist_patterns = {
	".*",
};

paths = {
	{ "./source", .relative = true, .recursive = true, },
};

linux_paths = {
	{ "./source",                                   .relative = true,  .recursive = true,  },
	{ "/home/nasr/.local/share/odin/vendor/raylib", .relative = false, .recursive = false, },
};

load_paths = {
	.win   = paths,
	.linux = linux_paths,
	.mac   = linux_paths,
};

commands = {
	.build = {
		.linux            = "./build.sh",
		.mac              = "./build.sh",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
	.run = {
		.linux            = "./build/drift",
		.mac              = "./build/drift",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
};

fkey_command = {
	.F1 = "build",
	.F2 = "run",
};
